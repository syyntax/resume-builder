# Copy to .env (or keep it outside this synced folder and point RT_ENV_FILE at it).

# Required: at least 32 random characters. Generate one with: openssl rand -base64 32
APP_SECRET_KEY=
# Or read it from a file (e.g. a Docker secret) instead:
# APP_SECRET_KEY_FILE=/run/secrets/app_secret_key

# The URL people use to reach the app. Keep the default for local use.
APP_BASE_URL=http://localhost:8080
APP_PORT=8080

# Registration: open | invite | closed. This is the initial value; admins can change it in the UI.
REGISTRATION_MODE=open
# Optional comma-separated email domains allowed to register in open mode, e.g. example.com
REGISTRATION_EMAIL_DOMAINS=

SESSION_IDLE_DAYS=7
SESSION_MAX_DAYS=30
LOG_LEVEL=INFO
# Two-step verification: none (optional for everyone) | admins | all. Initial value; admins can change it.
# REQUIRE_MFA=none

# ---- Email (optional) -----------------------------------------------------------------------------
# With these set, people can reset their own password, invites are emailed, and open sign-ups confirm their
# address. Without them, admins share reset and invite links themselves.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls                 # starttls (port 587) | ssl (port 465) | none (a relay on your network)
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Resume Tailor <resumes@example.com>

# ---- AI -------------------------------------------------------------------------------------------
# Each user adds their own Anthropic API key in the app (Account → AI). Optionally, a shared key that an
# admin can let people without their own key use (off until enabled under Admin → AI):
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ALLOWED_MODELS=claude-opus-5-5
# Default monthly spending cap per user in estimated USD (0 = unlimited).
DEFAULT_MONTHLY_CAP_USD=20
AI_MAX_CONCURRENT_JOBS=4
# The claim audit: a second, cheap pass that flags claims overstating their sources (on by default).
# AI_CLAIM_AUDIT=true
# Try the app without an API key: a deterministic offline stand-in model (not real tailoring).
# AI_PROVIDER=fake
# While rotating APP_SECRET_KEY, put the old value here and run: resume-tailor keys rotate
# APP_SECRET_KEY_PREVIOUS=

# ---- HTTPS profile (docker compose --profile https up -d) ----------------------------------------
# SITE_ADDRESS=resumes.example.com        # Caddy gets a certificate for this name
# APP_BASE_URL=https://resumes.example.com
# TRUSTED_PROXIES=*                        # trust X-Forwarded-For from Caddy on the compose network

# ---- PostgreSQL profile (docker compose --profile postgres up -d) -----------------------------
# POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql://resume_tailor:change-me@postgres/resume_tailor

# Testing only: allow a non-local APP_BASE_URL over plain http (e.g. on a home LAN).
# ALLOW_INSECURE_HTTP=true
